      "locked": "2026-11-09",
      "sha256": "16902c455d72b5220da90cd2e2df14e4cc4599e6d306e2f188ea505d80a9df78"
    },
    "anchor-2": {
      "file": "anchor-2.flac",
      "text": "والعشر آيات دول… فيهم بداية قصتهم.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "8f1c5966ab847c30",
