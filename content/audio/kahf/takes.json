      "locked": "2026-11-09",
      "sha256": "28402635835b11233a4be8db86080dba46fa3f567a926e6b0b0abba8a8263594"
    },
    "cave-1": {
      "file": "cave-1.flac",
      "text": "جوه الكهف… الشمس وهي طالعة تميل عنهم يِمِين… وهي بتغرب تبعد عنهم شمال… وهما في وسع منه.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "eb39a762f31eb88f",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-09",
      "sha256": "c7757ff2fa2347a7e544648b9db2290ee0097dd2a2a43a1cc53d74b3c6079743"
    },
    "cave-2": {
      "file": "cave-2.flac",
      "text": "تحسبهم صاحيين… وهما نايمين. وربنا بيقلّبهم يمين وشمال… وكلبهم مادد إيديه على باب الكهف.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "a7d0432bad815274",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-09",
      "sha256": "159780eb52142092702c191bc29adba3ef27d21f1664b250a33e2f6499b0c178"
    },
    "cave-lesson": {
      "file": "cave-lesson.flac",
      "text": "لما تلجأ لربنا… هو بيدبّرلك أصغر تفصيلة.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "e24ce681abd4b30e",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-09",
      "sha256": "f88b648f1f44836a24f9e2151f2a6398315028d13638e851ac5f6c554b1aed91"
    },
    "cave-life-1": {
      "file": "cave-life-1.flac",
      "text": "زي لما تسيب حاجة عشان ربنا… وتحس إن الدنيا ضاقت عليك.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "ecb129951a8749e7",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-09",
      "sha256": "036e85ee37f1a686ecb14f890f4c88b5fc5f201702f5f7f2b34457e1c89c843e"
    },
    "cave-life-2": {
      "file": "cave-life-2.flac",
      "text": "وبعدين تلاقي ربنا مسهّلها… من حتة عمرك ما فكرت فيها.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "1be7fe6f7c3c680f",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-09",
      "sha256": "9db863861759b177d4111052fc237d84706f334470ea6f7a6a68e52c1cc7d54e"
    },
    "cave-outro": {
      "file": "cave-outro.flac",
      "text": "وفي يوم… صِحْيُو. تابعنا عشان تعرف لقوا إيه.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "fb7206e675e74c3d",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-09",
      "sha256": "c115f9821cb6a224ac39f4e4d406dd90290d4e85e4121c6fd162947917435c3c",
      "phrases": {
