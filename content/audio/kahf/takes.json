  "takes": {
    "anchor": {
      "file": "anchor.flac",
      "text": "والنبي صلى الله عليه وسلم قال: مَنْ حَفِظَ عَشْرَ آيَاتٍ مِنْ أَوَّلِ سُورَةِ الْكَهْفِ عُصِمَ مِنَ الدَّجَّالِ",
      "engine": "voicetut",
