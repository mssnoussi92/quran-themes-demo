          0.08,
          0.82,
          1.44
        ]
      }
    },
    "end-1": {
      "file": "end-1.flac",
      "text": "الناس اختلفوا: كانوا كام؟ تلاتة… خمسة… سبعة؟ وربنا قال: هو أعلم بعددهم… ومتتجادلش فيهم.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "ec85db728b886013",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-09",
      "sha256": "113548c9c60a94d6ffdc4d3bbae9115e075266d04f6870629cf215ab0f97a5e3"
    },
    "end-2": {
      "file": "end-2.flac",
      "text": "بس قالنا قعدوا قد إيه.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "a511d5503629e7de",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-09",
      "sha256": "339828bd4a00f4f46306b47d790c859991f9096e30f4fe632529879ef6416dac"
    },
    "end-dua": {
      "file": "end-dua.flac",
      "text": "ودعوتهم… خليها معاك لما تحس إنك لوحدك.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "dd9d311036d6569d",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-09",
      "sha256": "90f67b3c2d2abc8cf522f9e6a3e4063a86d7877eb04b6c8724141413227182c0"
    },
    "end-lesson": {
      "file": "end-lesson.flac",
      "text": "مش كل سؤال يستاهل خناقة… المهم الدرس.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "3142c7cb1f496b87",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-09",
      "sha256": "3ce39b225bee921cc32c13e43238cffb7a4fb47a743cecfcb747bd10e23188f5"
    },
    "end-life-1": {
      "file": "end-life-1.flac",
      "text": "زي ناس بتتخانق على تفاصيل القصة… وتنسى القصة نفسها.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "0b11121bceb382eb",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-09",
      "sha256": "67410d37e8747601c149808980fa9a0ab71129a95631247a764fedbeda6caa02"
    },
    "end-outro": {
      "file": "end-outro.flac",
      "text": "فالمرة الجاية لما تكون الوحيد اللي بيصلي… افتكر الكهف.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "13a72ad735ae1ca8",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-09",
      "sha256": "6cf9a6554cacda9d861d726a90aff4c11860b9c2aa99676c7ae8fe74f24f5829",
      "phrases": {
        "tight": 2,
        "starts": [
          0.08,
          3.26
        ]
      }
    },
    "end-recap": {
      "file": "end-recap.flac",
      "text": "وقفوا لوحدهم… ربنا ثبّتهم… ورحمهم… وصحّاهم آية للناس.",
