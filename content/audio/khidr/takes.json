    "wall-lesson-2": {
      "file": "wall-lesson-2.flac",
      "text": "الخير ممكن يكون مستخبي… ومستني وقته. والحكمة هنا… اتْكَشَفِت بعد سنين.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "c12b9c37773c4a72",
