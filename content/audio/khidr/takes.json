      "sha256": "7468fc8ec20e76441c3e369d0e5ea0b9cb1bd94d45d9b72d1bfa7072482ba930"
    },
    "wall-bridge": {
      "file": "wall-bridge.flac",
      "text": "وهنا افترقوا… بس قبل ما يمشي… الخَضِر قاله السر:",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "9063ab5a4bd1d34d",
