      "sha256": "e2da3583e92feef0d50be1fe58cdc619e53e2749c25ce02859d834e9f1dfcdaf"
    },
    "ship-lesson-2": {
      "file": "ship-lesson-2.flac",
      "text": "خسارة صغيرة… حمتهم من خسارة أكبر. والحكمة هنا… اتْكَشَفِت بسرعة.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "f24a077974504eab",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-08",
      "sha256": "1d02edf49c45f03f2af1848a15e9e7ee7d787df7340d7b0d4f5203aa16a7627f"
    },
    "ship-life-1": {
      "file": "ship-life-1.flac",
      "text": "زي لما القطر يفوتك… وتتعصب إنك اتأخرت.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "5125402c12e70815",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-08",
      "sha256": "0f7fb694030903c4778ab2e06a8761513c86e35a0a53bafe9e1ea0f154089b71"
    },
    "ship-life-2": {
      "file": "ship-life-2.flac",
      "text": "وبعد ساعة تعرف… إنه عطل في نص الطريق.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "71e4b3820376388a",
      "validated_by": "mssnoussi92",
      "locked": "2026-11-08",
      "sha256": "495bdadc559f5317e773bad62b421b9485d53cf14a6b2304bb1a9e45d0a2832f"
    },
    "ship-outro": {
      "file": "ship-outro.flac",
      "text": "بس مش كل حكمة بتبان بسرعة… تابعنا عشان تعرف.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "0fe7fbac859c82d9",
