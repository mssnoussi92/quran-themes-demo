    },
    "ship-lesson-1": {
      "file": "ship-lesson-1.flac",
      "text": "العيب اللي في السفينة… هو اللي حماها.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "d2971756e6aea6d8",
