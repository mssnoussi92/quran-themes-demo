    },
    "wall-life-1": {
      "file": "wall-life-1.flac",
      "text": "زي لما تترفض من شغل كنت بتحلم بيه… وتفضل زعلان سنين.",
      "engine": "voicetut",
      "speaker": "Mohammed",
      "key": "f7fbac4cc49ee824",
