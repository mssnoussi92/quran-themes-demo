      "sha256": "88af242ba8a2ea33e8cfde77aba2006ae7fa9b0c5f975fde4935198968b341c3"
    },
    "wall-2": {
      "file": "wall-2.flac",
      "text": "ولقوا جدار عايز يقع… والخَضِر صلّحه!",
