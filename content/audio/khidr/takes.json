      "sha256": "a5d49a7f4f5968490f474a26cea93f504ed94234e35af40f6c094d64a5a3c858"
    },
    "wall-1": {
      "file": "wall-1.flac",
      "text": "موسى والخَضِر دخلوا قرية… طلبوا من أهلها أكل… ورفضوا يِضَيّفوهم.",
      "engine": "voicetut",
