      "sha256": "ba642dbcec381a79053809fa7074e2d902d7fc1baa1b0c2ce7498e9d07b45c7d"
    },
    "wall-lesson-1": {
      "file": "wall-lesson-1.flac",
      "text": "كنز مستخبي تحت جدار… مستني الولدين يكبروا.",
