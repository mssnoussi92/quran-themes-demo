{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mssnoussi92/quran-themes-demo/schemas/source.schema.json",
  "title": "Source registry file",
  "description": "A list of quotable sources. Texts are filled from an API by tooling, never typed by hand.",
  "type": "array",
  "items": { "$ref": "#/$defs/source" },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "type", "ref", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$" },
        "type": { "enum": ["ayah", "hadith", "athar", "tafsir"] },
        "ref": { "type": "object" },
        "text_ar": { "type": ["string", "null"] },
        "text_en": { "type": ["string", "null"] },
        "translation": { "type": "string" },
        "grade": { "enum": ["sahih", "hasan", "daif", "mawdu"] },
        "graded_by": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "status": { "enum": ["proposed", "validated", "excluded"] },
        "validated_by": { "type": "string" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "ayah" } } },
          "then": {
            "properties": {
              "id": { "pattern": "^quran\\.[0-9]{1,3}\\.[0-9]{1,3}$" },
              "ref": {
                "type": "object",
                "required": ["surah", "ayah"],
                "additionalProperties": false,
                "properties": {
                  "surah": { "type": "integer", "minimum": 1, "maximum": 114 },
                  "ayah": { "type": "integer", "minimum": 1, "maximum": 286 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "hadith" } } },
          "then": {
            "required": ["grade", "graded_by"],
            "properties": {
              "id": { "pattern": "^hadith\\.[a-z]+\\.[0-9]+[a-z]?$" },
              "ref": {
                "type": "object",
                "required": ["collection", "number"],
                "additionalProperties": false,
                "properties": {
                  "collection": { "type": "string", "pattern": "^[a-z]+$" },
                  "number": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "validated" } } },
          "then": { "required": ["text_ar", "text_en", "validated_by"] }
        }
      ]
    }
  }
}
