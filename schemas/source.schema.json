{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mssnoussi92/quran-themes-demo/schemas/source.schema.json",
  "title": "Source registry file",
  "description": "A list of quotable sources. Texts are filled from an API by tooling, never typed by hand.",
  "type": "array",
  "items": { "$ref": "#/$defs/source" },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "type", "ref", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$" },
        "type": { "enum": ["ayah", "hadith", "athar", "tafsir", "science"] },
        "ref": { "type": "object" },
        "text_ar": { "type": ["string", "null"] },
        "text_en": { "type": ["string", "null"] },
        "translation": { "type": "string" },
        "excerpt_ar": {
          "description": "For a hadith too long for a card (the whole story of Musa and al-Khidr, Bukhari 122): the passage of the Prophet's words the card shows and the reader says, instead of everything between the first and last quotation marks. Copied from text_ar, never typed: validate.py checks it is part of the Prophet's words",
          "type": "string",
          "minLength": 1
        },
        "excerpt_en": {
          "description": "Passage of text_en shown as the English subtitle (copied from it, never typed: validate.py checks it is part of text_en)",
          "type": "string",
          "minLength": 1
        },
        "grade": { "enum": ["sahih", "hasan", "daif", "mawdu"] },
        "graded_by": { "type": "string" },
        "url": { "type": "string", "format": "uri", "description": "Page to read the source (quran.com, sunnah.com)" },
        "origin": {
          "description": "Where text_ar / text_en were fetched from (written by tools/sources/fetch.py)",
          "type": "object",
          "required": ["api", "text_ar", "retrieved"],
          "additionalProperties": false,
          "properties": {
            "api": { "type": "string" },
            "text_ar": { "type": "string", "format": "uri" },
            "text_en": { "type": "string", "format": "uri" },
            "translator": { "type": "string" },
            "surah_ar": { "type": "string", "description": "Name of the surah (verses), from quran.com" },
            "surah_en": { "type": "string" },
            "edition": { "type": "string", "description": "Name of the tafsir as the API gives it" },
            "verses": {
              "description": "The verses the passage of a tafsir explains, as the API gives them (a passage may cover several)",
              "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]{1,3}:[0-9]{1,3}$" }
            },
            "book": { "type": "integer" },
            "hadith_in_book": { "type": "integer" },
            "grades": {
              "description": "Grades published by the API, copied as is",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "grade"],
                "additionalProperties": false,
                "properties": { "name": { "type": "string" }, "grade": { "type": "string" } }
              }
            },
            "retrieved": { "type": "string", "format": "date" }
          }
        },
        "label": {
          "description": "For a science source: the short names written on screen after the sources of a narration (ar for the Arabic part, en for the English part)",
          "type": "object",
          "required": ["ar", "en"],
          "additionalProperties": false,
          "properties": { "ar": { "type": "string" }, "en": { "type": "string" } }
        },
        "claim": { "type": "string", "description": "For a science source: what the paper or the data say, in a line (what the script may rest on)" },
        "checked": {
          "description": "For a science source: when the claim was checked and against which pages",
          "type": "object",
          "required": ["on", "sources"],
          "additionalProperties": false,
          "properties": {
            "on": { "type": "string", "format": "date" },
            "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } }
          }
        },
        "status": { "enum": ["proposed", "validated", "excluded"] },
        "validated_by": { "type": "string" },
        "notes": { "type": "string" },
        "recording": {
          "description": "A person reading the hadith aloud (a recorded reading of the book), heard instead of the synthetic voice for the words shown (display_ar). start/end found with Whisper; heard = what Whisper hears there, compared with the text by validate.py. The owner listens before validating it.",
          "type": "object",
          "required": ["reader", "item", "file", "start", "end", "heard", "license", "status"],
          "additionalProperties": false,
          "properties": {
            "reader": { "type": "string" },
            "item": { "type": "string", "format": "uri", "description": "Page of the recording (archive.org item)" },
            "file": { "type": "string", "format": "uri", "description": "Audio file downloaded by tools/audio/build.py" },
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 },
            "heard": { "type": "string" },
            "license": { "type": "string", "description": "What the item says about reuse (\"none stated\" if nothing)" },
            "status": { "enum": ["proposed", "validated"] },
            "validated_by": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "ayah" } } },
          "then": {
            "properties": {
              "origin": { "required": ["text_en"] },
              "id": { "pattern": "^quran\\.[0-9]{1,3}\\.[0-9]{1,3}$" },
              "ref": {
                "type": "object",
                "required": ["surah", "ayah"],
                "additionalProperties": false,
                "properties": {
                  "surah": { "type": "integer", "minimum": 1, "maximum": 114 },
                  "ayah": { "type": "integer", "minimum": 1, "maximum": 286 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "hadith" } } },
          "then": {
            "required": ["grade", "graded_by"],
            "properties": {
              "origin": { "required": ["text_en"] },
              "id": { "pattern": "^hadith\\.[a-z]+\\.[0-9]+[a-z]?$" },
              "ref": {
                "type": "object",
                "required": ["collection", "number"],
                "additionalProperties": false,
                "properties": {
                  "collection": { "type": "string", "pattern": "^[a-z]+$" },
                  "number": { "type": "integer", "minimum": 1 },
                  "narration": {
                    "description": "Which narration when one number covers several (Muslim 2679a = 1): id ends with a, b...",
                    "type": "integer", "minimum": 1, "maximum": 26
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "tafsir" } } },
          "then": {
            "description": "The passage of a tafsir about one verse: what a line of meaning rests on. Never read, never shown: only its name is written (content/policy.yaml, tafsir.editions). No English text.",
            "properties": {
              "id": { "pattern": "^tafsir\\.[a-z-]+\\.[0-9]{1,3}\\.[0-9]{1,3}$" },
              "text_en": false,
              "ref": {
                "type": "object",
                "required": ["edition", "surah", "ayah"],
                "additionalProperties": false,
                "properties": {
                  "edition": { "type": "string", "pattern": "^[a-z-]+$" },
                  "surah": { "type": "integer", "minimum": 1, "maximum": 114 },
                  "ayah": { "type": "integer", "minimum": 1, "maximum": 286 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "science" } } },
          "then": {
            "description": "A paper or a dataset the script rests on, not a quoted text: it carries labels, a claim and the pages it was checked against. No text, nothing fetched.",
            "required": ["url", "label", "checked"],
            "properties": {
              "id": { "pattern": "^science\\.[a-z0-9-]+$" },
              "text_ar": false,
              "text_en": false,
              "origin": false,
              "ref": {
                "type": "object",
                "required": ["year"],
                "properties": { "year": { "type": "integer" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "validated" } } },
          "then": { "required": ["validated_by"] }
        },
        {
          "if": { "properties": { "status": { "const": "validated" }, "type": { "enum": ["ayah", "hadith", "athar", "tafsir"] } } },
          "then": { "required": ["text_ar"] }
        },
        {
          "if": { "properties": { "status": { "const": "validated" }, "type": { "enum": ["ayah", "hadith", "athar"] } } },
          "then": { "required": ["text_en"] }
        }
      ]
    }
  }
}
