{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mssnoussi92/quran-themes-demo/schemas/episode.schema.json",
  "title": "Episode script",
  "description": "One episode, split into scenes. Quotations are referenced by source id only.",
  "type": "object",
  "required": ["episode", "title", "narration_language", "reels", "scenes"],
  "additionalProperties": false,
  "properties": {
    "episode": { "$ref": "#/$defs/slug" },
    "title": { "$ref": "#/$defs/i18n" },
    "narration_language": { "enum": ["ar-msa", "ar-egy"] },
    "publish": { "$ref": "#/$defs/publish" },
    "reels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "title": { "$ref": "#/$defs/i18n" },
          "validated_by": {
            "description": "Owner who validated the reel's script and translation; removed whenever one of its lines changes",
            "type": "string"
          },
          "publish": { "$ref": "#/$defs/publish" }
        }
      }
    },
    "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "publish": {
      "description": "Publication texts pasted with the video by the owner (video/scripts/publish.ts adds the sources, credits, chapters and the other hashtags). On the episode: the whole episode's title and description, and the theme hashtags of all its videos; on a reel: its title and description (and hashtags of its own)",
      "type": "object",
      "required": ["title", "description"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/i18n" },
        "description": { "$ref": "#/$defs/i18n" },
        "hashtags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^#\\w+$" } },
        "validated_by": {
          "description": "Owner who validated these texts (on the episode: with its hashtags); removed whenever one of them changes",
          "type": "string"
        }
      }
    },
    "i18n": {
      "type": "object",
      "required": ["ar", "en"],
      "additionalProperties": false,
      "patternProperties": { "^[a-z]{2}$": { "type": "string", "minLength": 1 } }
    },
    "scene": {
      "type": "object",
      "required": ["id", "role", "audio", "visual"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "role": { "enum": ["hook", "promise", "misconception", "evidence", "conclusion", "outro"] },
        "reel": { "$ref": "#/$defs/slug" },
        "audio": { "enum": ["tts", "recitation", "none"] },
        "narration": { "$ref": "#/$defs/i18n" },
        "source": { "type": "string" },
        "mentions": {
          "description": "Real people named in the scene (prophets, Companions, known people). Forbids characters.",
          "type": "array",
          "items": { "type": "string" }
        },
        "say_ar": {
          "description": "What the voice reads when the pronunciation must differ from the text shown: the same words, a silent ta marbuta written ha (« عادة » read « عاده »). The screen shows narration.ar.",
          "type": "string"
        },
        "reel_only_end": {
          "description": "End of the narration said only in the reel on its own (the open loop to the next reel, « ده اللي جاي »): the whole-episode videos stop the line just before it. Whole phrases at the end of narration.ar, and the matching end of narration.en.",
          "$ref": "#/$defs/i18n"
        },
        "visual": { "$ref": "#/$defs/visual" }
      }
    },
    "visual": {
      "type": "object",
      "required": ["template"],
      "additionalProperties": false,
      "properties": {
        "template": { "enum": ["scene", "ayah-card", "source-card", "name-card", "title-card"] },
        "background": { "$ref": "#/$defs/slug" },
        "icon": { "$ref": "#/$defs/slug" },
        "highlight": { "enum": ["words", "none"] },
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "pose", "mood"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "pose": { "type": "string" },
              "mood": { "type": "string" },
              "talking": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
